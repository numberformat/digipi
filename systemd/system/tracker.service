[Unit]
Description=tracker

[Service]
ExecStartPre=-+/bin/systemctl stop tnc fldigi sstv wsjtx ardop tnc300b digipeater node winlinkrms pat js8call webchat
ExecStart=/home/pi/direwolf.tracker.sh
WorkingDirectory=/home/pi/
StandardOutput=inherit
